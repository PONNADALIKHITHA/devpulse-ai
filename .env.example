# DevPulse AI - Environment Configuration Example
# Copy this file to .env for local development

# Supported providers: 'gemini', 'groq', or 'mock'
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional alternative from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Model name to use
# For Gemini: gemini-1.5-flash or gemini-2.0-flash
# For Groq: llama-3.1-8b-instant (recommended), llama-3.1-70b-versatile, or llama-3.3-70b-versatile
MODEL_NAME=gemini-1.5-flash
